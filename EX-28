// Top Module
SC_MODULE(Top)
{
    // Counting semaphore with 3 resources
    sc_semaphore semaphore;

    ProcessA processA;
    ProcessB processB;
    ProcessC processC;

    SC_CTOR(Top)
        : semaphore("CountingSemaphore", 3),
          processA("ProcessA"),
          processB("ProcessB"),
          processC("ProcessC")
    {
        processA.semaphore = &semaphore;
        processB.semaphore = &semaphore;
        processC.semaphore = &semaphore;
    }
};


// Main
int sc_main(int argc, char* argv[])
{
    Top top("Top");

    sc_start(20, SC_NS);

    return 0;
}
