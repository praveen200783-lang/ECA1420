#include <systemc.h>

// Process A
SC_MODULE(ProcessA)
{
    sc_semaphore* semaphore;

    SC_CTOR(ProcessA)
    {
        SC_THREAD(run);
    }

    void run()
    {
        cout << sc_time_stamp()
             << " Process A: Waiting for semaphore"
             << endl;

        semaphore->wait();

        cout << sc_time_stamp()
             << " Process A: Acquired semaphore"
             << endl;

        cout << sc_time_stamp()
             << " Process A: Using resource"
             << endl;

        wait(5, SC_NS);

        cout << sc_time_stamp()
             << " Process A: Releasing semaphore"
             << endl;

        semaphore->post();
    }
};


