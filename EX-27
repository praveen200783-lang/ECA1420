            wait(2, SC_NS);
        }
    }
};


SC_MODULE(Top)
{
    sc_semaphore semaphore;

    ProcessA processA;
    ProcessB processB;

    SC_CTOR(Top)
        : semaphore("BinarySemaphore", 1),
          processA("ProcessA"),
          processB("ProcessB")
    {
        processA.semaphore = &semaphore;
        processB.semaphore = &semaphore;
    }
};


int sc_main(int argc, char* argv[])
{
    Top top("Top");

    sc_start(50, SC_NS);

    return 0;
}
